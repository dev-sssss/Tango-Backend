# Tango Cards server stack ({{ tango_environment }}). Managed by Ansible.
#   postgres     - database (accounts, wallets, storage, leaderboards, cluster state)
#   tango-node1  - game server node (API + WebSocket gateway + match host)
#   tango-node2  - second node: deploys restart one node at a time and live
#                  matches move to the other node, so no game is interrupted
#   nginx        - TLS, WebSocket upgrade, load balancing, rate limits
name: tango

x-node: &node
  image: "{{ tango_image }}"
  restart: unless-stopped
  stop_grace_period: 45s
  depends_on:
    postgres:
      condition: service_healthy
  volumes:
    - ./config/node.yml:/etc/tango/node.yml:ro
  networks: [tango]
  ulimits:
    nofile: { soft: 65536, hard: 65536 }

services:
  postgres:
    image: "{{ postgres_image }}"
    restart: unless-stopped
    environment:
      POSTGRES_USER: tango
      POSTGRES_DB: tango
      POSTGRES_PASSWORD: ${POSTGRES_PASSWORD}
    command: ["postgres", "-c", "shared_buffers=256MB", "-c", "max_connections=200", "-c", "effective_cache_size=1GB"]
    shm_size: 256mb
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U tango -d tango"]
      interval: 3s
      timeout: 3s
      retries: 30
    networks: [tango]

  migrate:
    <<: *node
    restart: "no"
    command: ["migrate", "up", "--config", "/etc/tango/node.yml"]
    profiles: ["tools"]

{% for n in tango_nodes %}
  tango-{{ n.name }}:
    <<: *node
    command: ["--config", "/etc/tango/node.yml", "--name", "{{ n.name }}", "--cluster.advertise_address", "tango-{{ n.name }}:7352"]
    ports:
      - "127.0.0.1:{{ n.admin_port }}:7351"

{% endfor %}
  nginx:
    image: "{{ nginx_image }}"
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./nginx/nginx.conf:/etc/nginx/nginx.conf:ro
      - ./certbot/www:/var/www/certbot:ro
      - ./certbot/conf:/etc/letsencrypt:ro
    networks: [tango]

  certbot:
    image: "{{ certbot_image }}"
    profiles: ["tools"]
    volumes:
      - ./certbot/www:/var/www/certbot
      - ./certbot/conf:/etc/letsencrypt

volumes:
  pgdata: {}

networks:
  tango:
    ipam:
      config:
        - subnet: 172.28.0.0/24
